# Kopiere diese Datei nach .env und trage die echten Werte ein.
# Alle PUBLIC_-Variablen landen im ausgelieferten HTML - keine Geheimnisse hier ablegen.

# Web3Forms Access Key (https://web3forms.com - kostenlos, Key wird per E-Mail zugeschickt)
PUBLIC_WEB3FORMS_KEY=

# Optional: Cloudflare Turnstile Site Key (Spamschutz). Leer lassen = Turnstile aus.
PUBLIC_TURNSTILE_SITE_KEY=
