---
import { home } from '../lib/content';
import type { Locale } from '../config/site';
import { pick } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { about } = home;
---

<section class="section" id="ueber-mich">
  <div class="wrap">
    <h2>{pick(about.title, locale)}</h2>

    <div class="grid">
      <div class="prose">
        {pick(about.text, locale).split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <figure>
        <img
          src={about.photo}
          alt={pick(about.photoAlt, locale)}
          width="1000"
          height="1250"
          loading="lazy"
          decoding="async"
        />
        {about.photoCredit && <figcaption class="credit">{about.photoCredit}</figcaption>}
      </figure>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: clamp(1.75rem, 5vw, 3.5rem);
    margin-top: 2rem;
  }

  figure {
    margin: 0;
  }

  figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
      align-items: start;
    }
  }
</style>
