---
import { home, settings } from '../lib/content';
import type { Locale } from '../config/site';
import { pick, localePath } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { contact } = home;

// Schluessel kommen aus .env (siehe .env.example). Beide sind oeffentlich sichtbar.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const kinds = [
  t(locale, 'form.kind.church'),
  t(locale, 'form.kind.civil'),
  t(locale, 'form.kind.reception'),
  t(locale, 'form.kind.funeral'),
  t(locale, 'form.kind.other'),
];
---

<section class="section" id="kontakt">
  <div class="wrap">
    <h2>{pick(contact.title, locale)}</h2>

    <div class="grid">
      <form
        class="form"
        data-contact-form
        data-key={web3formsKey}
        data-email={settings.email}
        data-sending={t(locale, 'form.sending')}
        data-submit={t(locale, 'form.submit')}
        data-success={t(locale, 'form.success')}
        data-error={t(locale, 'form.error')}
        novalidate
      >
        <div class="field">
          <label for="name">{t(locale, 'form.name')}</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">{t(locale, 'form.email')}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="row">
          <div class="field">
            <label for="date">{t(locale, 'form.date')}</label>
            <input id="date" name="datum" type="date" />
          </div>

          <div class="field">
            <label for="place">{t(locale, 'form.place')}</label>
            <input id="place" name="ort" type="text" autocomplete="address-level2" />
          </div>
        </div>

        <div class="field">
          <label for="kind">{t(locale, 'form.kind')}</label>
          <select id="kind" name="anlass">
            {kinds.map((kind) => <option value={kind}>{kind}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="message">{t(locale, 'form.message')}</label>
          <textarea id="message" name="nachricht" rows="5" placeholder={t(locale, 'form.messagePlaceholder')} required
          ></textarea>
        </div>

        <div class="consent">
          <input id="consent" name="einwilligung" type="checkbox" required />
          <label for="consent" class="small">
            {t(locale, 'form.consent')}{' '}
            <a href={localePath('/datenschutz', locale)}>{t(locale, 'form.consentLink')}</a>
          </label>
        </div>

        {/* Honigtopf: fuer Menschen unsichtbar, Bots fuellen ihn aus. */}
        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="botcheck" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-appearance="interaction-only"></div>}

        <button class="button" type="submit">{t(locale, 'form.submit')}</button>

        <p class="status small" data-form-status role="status" aria-live="polite"></p>
      </form>

      <aside class="aside">
        <p class="prose">{pick(contact.text, locale)}</p>

        <p class="small direct">
          <a href={`mailto:${settings.email}`}>{settings.email}</a>
          {settings.phone && <><br /><a href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a></>}
          <br />{pick(settings.region, locale)}
        </p>

        {contact.note && <p class="small muted">{pick(contact.note, locale)}</p>}
      </aside>
    </div>
  </div>
</section>

{turnstileKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    const setStatus = (text: string, state: 'ok' | 'error' | '') => {
      if (!status) return;
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const key = form.dataset.key ?? '';
      const email = form.dataset.email ?? '';

      // Ohne Access Key kann nichts verschickt werden - dann direkt auf die
      // E-Mail-Adresse verweisen, statt den Versand vorzutaeuschen.
      if (!key) {
        setStatus(`${form.dataset.error} ${email}`, 'error');
        return;
      }

      data.append('access_key', key);
      data.append('subject', `Anfrage über die Website: ${data.get('name') ?? ''}`);
      data.append('from_name', 'Website-Formular');

      if (button) {
        button.disabled = true;
        button.textContent = form.dataset.sending ?? '';
      }
      setStatus('', '');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: data,
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          setStatus(form.dataset.success ?? '', 'ok');
        } else {
          setStatus(`${form.dataset.error} ${email}`, 'error');
        }
      } catch {
        setStatus(`${form.dataset.error} ${email}`, 'error');
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = form.dataset.submit ?? '';
        }
      }
    });
  }
</script>

<style>
  .grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    margin-top: 2rem;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    max-width: 34rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .row {
    display: grid;
    gap: 1.1rem;
  }

  label {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  select,
  textarea {
    font-family: var(--sans);
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.6rem 0.7rem;
    width: 100%;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--ink-soft);
  }

  textarea {
    resize: vertical;
    line-height: 1.5;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
  }

  .consent input {
    width: 1rem;
    height: 1rem;
    margin-top: 0.2rem;
    accent-color: var(--string);
  }

  .consent label {
    font-weight: 400;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .button {
    justify-self: start;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
  }

  .status[data-state='ok'] {
    color: var(--ink);
    border-left: 2px solid var(--string);
    padding-left: 0.75rem;
  }

  .status[data-state='error'] {
    color: var(--string);
  }

  .aside .direct {
    line-height: 1.8;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      align-items: start;
    }
  }
</style>
