---
import { settings } from '../lib/content';
import { enabledLocales, locales, defaultLocale, type Locale } from '../config/site';
import { pick, localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path: string;
}

const { locale, title, description, path } = Astro.props;
const site = Astro.site ?? new URL('https://example.at');
const canonical = new URL(localePath(path, locale), site);
const desc = description ?? pick(settings.seo.description, locale);
const ogImage = new URL(settings.seo.image, site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical.href} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#f2f3ee" />

{/* hreflang nur fuer Sprachen, die auch gebaut werden */}
{
  enabledLocales.length > 1 &&
    enabledLocales.map((l) => (
      <link rel="alternate" hreflang={locales[l].hreflang} href={new URL(localePath(path, l), site).href} />
    ))
}
{
  enabledLocales.length > 1 && (
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(path, defaultLocale), site).href} />
  )
}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:locale" content={locales[locale].htmlLang.replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />
