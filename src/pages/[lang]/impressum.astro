---
import LegalView from '../../views/LegalView.astro';
import { secondaryLocales, type Locale } from '../../config/site';

export function getStaticPaths() {
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<LegalView locale={locale} slug="impressum" />
