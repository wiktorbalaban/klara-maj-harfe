---
import HomeView from '../../views/HomeView.astro';
import { secondaryLocales, type Locale } from '../../config/site';

// Solange in src/config/site.ts nur Deutsch aktiv ist, ist diese Liste leer
// und es entsteht keine einzige englische Seite.
export function getStaticPaths() {
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<HomeView locale={locale} />
