---
import Base from '../layouts/Base.astro';
import RepertoireList from '../components/RepertoireList.astro';
import { repertoire, settings } from '../lib/content';
import type { Locale } from '../config/site';
import { pick, localePath } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = `${t(locale, 'nav.repertoire')} – ${settings.name}`;
---

<Base locale={locale} title={title} path="/repertoire/">
  <section class="section">
    <div class="wrap">
      <h1>{t(locale, 'nav.repertoire')}</h1>
      <p class="lead prose intro">{pick(repertoire.intro, locale)}</p>

      <nav class="index small" aria-label={t(locale, 'nav.repertoire')}>
        <ul>
          {repertoire.groups.map((group) => (
            <li><a href={`#${group.id}`}>{pick(group.title, locale)}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="section list">
    <div class="wrap">
      <RepertoireList locale={locale} />

      <p class="closing prose">
        {t(locale, 'repertoire.request')}{' '}
        <a class="text-link" href={`${localePath('/', locale)}#kontakt`}>{t(locale, 'repertoire.contact')}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .intro {
    margin-top: 1.5rem;
  }

  .index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .list {
    padding-top: 0;
    border-top: 0;
  }

  .closing {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
